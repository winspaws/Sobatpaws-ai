    {
      "name": "3. Konsultasi (Multimodal)",
      "item": [
        {
          "name": "Start Consultation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"vet_id\": 1,\n    \"owner_id\": 100,\n    \"pet_id\": 200,\n    \"category_slug\": \"cat\",\n    \"breed_slug\": \"cat-persian\",\n    \"age_years\": 3,\n    \"sex\": \"male\",\n    \"weight_kg\": 4.5,\n    \"external_consultation_id\": \"ext-20250619-001\"\n  },\n  \"intake\": {\n    \"channel\": \"chat\",\n    \"text\": \"Kucing saya muntah hebat dan tidak mau makan sejak kemarin\",\n    \"is_first_contact\": true,\n    \"author_role\": \"owner\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/consultations",
              "host": ["{{base_url}}"],
              "path": ["consultations"]
            },
            "description": "Mulai sesi konsultasi baru. Response mengandung consultation_id dan AISuggestion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.consultation_id) {",
                  "  pm.collectionVariables.set('consultation_id', jsonData.consultation_id);",
                  "  pm.collectionVariables.set('suggestion_id', jsonData.suggestion_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Consultation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultations/{{consultation_id}}",
              "host": ["{{base_url}}"],
              "path": ["consultations", "{{consultation_id}}"]
            },
            "description": "Detail sesi konsultasi."
          }
        },
        {
          "name": "Add Turn",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intake\": {\n    \"channel\": \"chat\",\n    \"text\": \"Sekarang kucing saya juga diare berdarah\",\n    \"is_first_contact\": false,\n    \"author_role\": \"owner\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/consultations/{{consultation_id}}/turns",
              "host": ["{{base_url}}"],
              "path": ["consultations", "{{consultation_id}}", "turns"]
            },
            "description": "Giliran lanjutan dalam sesi — saran diperbarui kumulatif."
          }
        },
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "file", "type": "file", "src": "", "description": "File audio/gambar"},
                {"key": "modality", "value": "audio", "description": "audio | image | video_frame"},
                {"key": "channel", "value": "voice", "description": "chat | video | voice | in_person"}
              ]
            },
            "url": {
              "raw": "{{base_url}}/consultations/{{consultation_id}}/media",
              "host": ["{{base_url}}"],
              "path": ["consultations", "{{consultation_id}}", "media"]
            },
            "description": "Upload media mentah (mic/kamera) sebagai multipart."
          }
        },
        {
          "name": "Doctor Input (Gold Label)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmed_disease_slug\": \"cat-fpv-panleukopenia\",\n  \"differential_disease_slugs\": [\"cat-ckd\"],\n  \"confirmed_symptoms\": [\"Muntah\", \"Diare hebat\", \"Nafsu makan menurun\"],\n  \"diagnostics_ordered\": [\"PCR feses\", \"CBC\"],\n  \"treatments_given\": [\"Terapi suportif rawat inap parvo\"],\n  \"products_prescribed\": [\"Maropitant (Cerenia)\"],\n  \"clinical_notes\": \"Pasien menunjukkan gejala klasik FPV. PCR positif.\",\n  \"outcome\": \"recovering\",\n  \"confidence\": 95\n}"
            },
            "url": {
              "raw": "{{base_url}}/consultations/{{consultation_id}}/doctor-input",
              "host": ["{{base_url}}"],
              "path": ["consultations", "{{consultation_id}}", "doctor-input"]
            },
            "description": "Simpan keputusan dokter sebagai gold label untuk retraining."
          }
        },
        {
          "name": "Feedback Saran AI",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"suggestion_ref\": \"{{suggestion_id}}\",\n  \"verdict\": \"correct\",\n  \"corrected_disease_slug\": \"cat-fpv-panleukopenia\",\n  \"comment\": \"Saran sangat membantu, diagnosa sesuai\",\n  \"reviewer_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/consultations/{{consultation_id}}/feedback",
              "host": ["{{base_url}}"],
              "path": ["consultations", "{{consultation_id}}", "feedback"]
            },
            "description": "Penilaian dokter atas saran AI (human-in-the-loop)."
          }
        }
      ]
