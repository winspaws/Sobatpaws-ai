# Salin ke .env dan isi nilai Anda. JANGAN commit .env.
# cp .env.example .env

# --- Database (opsional lokal; kosongkan DATABASE_URL untuk JSONL-only) ---
DATABASE_URL=postgresql://user:password@localhost:5432/sobatpaws

# --- Auth API (opsional; kosong = mode dev tanpa auth) ---
SOBATPAWS_VET_API_KEY=
SOBATPAWS_ADMIN_API_KEY=

# --- CORS (production: domain app vet & admin) ---
SOBATPAWS_CORS_ORIGINS=http://localhost:3000,http://localhost:3333,http://localhost:8080,http://127.0.0.1:8000

# Rate limit (0 = off). Default 120 req/menit/IP.
RATE_LIMIT_PER_MINUTE=120

# --- AI Provider utama ---
# openai | anthropic | local (Ollama / SumoPod OpenAI-compatible)
SOBATPAWS_AI_PROVIDER=local

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- SumoPod + Pawnia AI (rekomendasi production) ---
LOCAL_LLM_BASE_URL=https://ai.sumopod.com/v1
LOCAL_LLM_API_KEY=sk-xxxx
LOCAL_LLM_MODEL=deepseek-v4-flash

# --- Ollama lokal (dev offline) ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=llama3.2

# Model tier Pawnia (opsional override)
PAWNIA_DEFAULT_MODEL=deepseek-v4-flash
PAWNIA_EMERGENCY_MODEL=deepseek-v4-pro
PAWNIA_VISION_MODEL=gemini/gemini-2.0-flash-lite

# Efisiensi token (template-first + LLM pendek)
SOBATPAWS_AI_TEMPERATURE=0.2
SOBATPAWS_AI_MAX_TOKENS=400
PAWNIA_MAX_TOKENS=220
SOBATPAWS_AI_AUGMENTATION_MODE=smart
# 0 = unlimited. Default hemat: ~250k token/hari (~Rp hemat di SumoPod)
SOBATPAWS_AI_DAILY_TOKEN_BUDGET=250000
SOBATPAWS_AI_CACHE_TTL_SEC=7200
SOBATPAWS_AI_SKIP_LLM_CONFIDENCE=0.75
SOBATPAWS_AI_FALLBACK_CHAIN=local,openai,anthropic

# --- Learning & session store ---
SOBATPAWS_LEARNING_BACKEND=jsonl
SOBATPAWS_AI_STORE_BACKEND=jsonl
SOBATPAWS_SESSION_BACKEND=jsonl

# --- Telegram Pawnia bot (opsional) ---
TELEGRAM_API_HASH=
PAWNIA_API_BASE=http://localhost:8000
