# =============================================================================
#  Sobatpaws — Production Environment Variables
#  Salin ke .env dan isi nilai rahasia. JANGAN commit .env ke git.
#
#  Cara pakai:
#    cp .env.production .env
#    # edit .env dengan editor
#    docker compose up -d
# =============================================================================

# --- Database ---
# PostgreSQL connection string (inside Docker network)
DATABASE_URL=postgresql://sobatpaws:***@postgres:5432/sobatpaws
# Password for the PostgreSQL sobatpaws user
POSTGRES_PASSWORD=***

# --- Auth API Keys ---
# Kosongkan di development; isi dengan nilai nyata di production
SOBATPAWS_VET_API_KEY=
SOBATPAWS_ADMIN_API_KEY=

# --- AI Provider ---
# Provider utama: openai | anthropic | local (Ollama/vLLM OpenAI-compatible)
SOBATPAWS_AI_PROVIDER=local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local LLM (Ollama / vLLM running on host)
# Gunakan host.docker.internal untuk akses dari container ke host
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=llama3.2

# --- AI Tuning ---
SOBATPAWS_AI_TEMPERATURE=0.2
SOBATPAWS_AI_MAX_TOKENS=800
SOBATPAWS_AI_AUGMENTATION_MODE=smart
SOBATPAWS_AI_DAILY_TOKEN_BUDGET=0
SOBATPAWS_AI_CACHE_TTL_SEC=3600
SOBATPAWS_AI_SKIP_LLM_CONFIDENCE=0.82
SOBATPAWS_AI_FALLBACK_CHAIN=local,openai,anthropic

# --- Storage Backends ---
# jsonl | postgres | both
SOBATPAWS_LEARNING_BACKEND=jsonl
SOBATPAWS_AI_STORE_BACKEND=jsonl
SOBATPAWS_SESSION_BACKEND=jsonl

# --- pgAdmin (optional) ---
PGADMIN_EMAIL=admin@sobatpaws.id
PGADMIN_PASSWORD=***

# --- Security ---
# Allowed CORS origins (comma-separated)
# SOBATPAWS_CORS_ORIGINS=http://localhost:3000,http://localhost:3333,https://admin.sobatpaws.com,https://app.sobatpaws.com
SOBATPAWS_CORS_ORIGINS=http://localhost:3000,http://localhost:3333,http://localhost:8080
