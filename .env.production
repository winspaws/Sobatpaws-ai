# =============================================================================
#  Ekosistem Satwa — Production Environment Variables
#  Salin ke .env dan isi nilai rahasia. JANGAN commit .env ke git.
#  (Rebranded from Ekosistem Satwa)
#
#  Cara pakai:
#    cp .env.production .env
#    # edit .env dengan editor
#    docker compose up -d
# =============================================================================

# --- Database ---
# PostgreSQL connection string (inside Docker network)
DATABASE_URL=postgresql://ekosistemsatwa:***@postgres:5432/ekosistemsatwa
# Password for the PostgreSQL ekosistemsatwa user
POSTGRES_PASSWORD=***

# --- Auth API Keys ---
# Kosongkan di development; isi dengan nilai nyata di production
EKOSISTEM_SATWA_VET_API_KEY=
EKOSISTEM_SATWA_ADMIN_API_KEY=

# --- AI Provider ---
# Provider utama: openai | anthropic | local (Ollama/vLLM OpenAI-compatible)
EKOSISTEM_SATWA_AI_PROVIDER=local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local LLM (Ollama / vLLM running on host)
# Gunakan host.docker.internal untuk akses dari container ke host
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=llama3.2

# --- AI Tuning ---
EKOSISTEM_SATWA_AI_TEMPERATURE=0.2
EKOSISTEM_SATWA_AI_MAX_TOKENS=800
EKOSISTEM_SATWA_AI_AUGMENTATION_MODE=smart
EKOSISTEM_SATWA_AI_DAILY_TOKEN_BUDGET=0
EKOSISTEM_SATWA_AI_CACHE_TTL_SEC=3600
EKOSISTEM_SATWA_AI_SKIP_LLM_CONFIDENCE=0.82
EKOSISTEM_SATWA_AI_FALLBACK_CHAIN=local,openai,anthropic

# --- Storage Backends ---
# jsonl | postgres | both
EKOSISTEM_SATWA_LEARNING_BACKEND=jsonl
EKOSISTEM_SATWA_AI_STORE_BACKEND=jsonl
EKOSISTEM_SATWA_SESSION_BACKEND=jsonl

# --- pgAdmin (optional) ---
PGADMIN_EMAIL=admin@ekosistemsatwa.id
PGADMIN_PASSWORD=***
