    {
      "slug": "adrenal-disease-ferret",
      "common_name": "Adrenal Gland Disease",
      "etiology": "Hiperplasia / adenoma / adenokarsinoma kelenjar adrenal, akibat neutering dini + siklus cahaya artifisial",
      "species": [
        "ferret"
      ],
      "prevalence": 0.7,
      "mortality_rate": 0.3,
      "contagious": false,
      "age_onset": "3-7 tahun",
      "clinical_signs": [
        "Alopesia simetris bilateral (dari ekor ke depan)",
        "Gatal kulit",
        "Vulva membesar pada betina",
        "Atrofi testis pada jantan",
        "Anemia",
        "Letargi",
        "Berat badan turun"
      ],
      "diagnostic_gold_standard": "Ultrasonografi abdominal + kadar hormon estradiol / 17-hydroxyprogesteron",
      "treatment": [
        "Deslorelin implant 4.7mg setiap 12-18 bulan",
        "Adrenalectomy bedah untuk kasus unilateral",
        "Melatonin oral 1mg/hari"
      ],
      "prognosis": "Baik dengan terapi medis, 2-4 tahun survival; guarded jika karsinoma metastatik",
      "references": [
        "Fox JG. 2014. Ferret medicine and surgery. 3rd Edition. Wiley-Blackwell",
        "AAFP Ferret Care Guidelines 2020"
      ],
      "status": "curated"
    },
