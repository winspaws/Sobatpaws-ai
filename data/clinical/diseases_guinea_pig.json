      "slug": "scurvy-guinea-pig",
      "common_name": "Scurvy (Defisiensi Vitamin C)",
      "etiology": "Guinea pig tidak dapat mensintesis vitamin C sendiri, defisiensi <10 mg/hari",
      "species": [
        "guinea_pig"
      ],
      "prevalence": 0.35,
      "mortality_rate": 0.2,
      "contagious": false,
      "clinical_signs": [
        "Anoreksia",
        "Kelemahan anggota gerak",
        "Gangguan berjalan / enggan bergerak",
        "Perdarahan gusi",
        "Petechiae kulit",
        "Nyeri sendi",
        "Kematian dalam 2-3 minggu"
      ],
      "diagnostic_gold_standard": "Kadar vitamin C darah <0.4 mg/dL + riwayat pakan",
      "treatment": [
        "Vitamin C parenteral 25-50 mg/kg IM/SC setiap 24 jam selama 7 hari",
        "Oral 10-30 mg/kg BID setelah fase akut",
        "Suplementasi harian permanen 10 mg/hari"
      ],
      "prognosis": "Sangat baik jika ditangani sebelum komplikasi",
      "references": [
        "Meredith A. 2020. Guinea Pig Medicine and Surgery. BSAVA Manual",
        "UC Davis Veterinary Medicine Exotic Pet Guidelines"
      ],
      "status": "curated"
    },
